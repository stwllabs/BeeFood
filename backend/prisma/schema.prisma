datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}


enum Role {
  STUDENT
  TENANT
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  DONE
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(STUDENT)
  balance     Float    @default(100000) // Default Rp 100.000 untuk simulasi pre-order
  phoneNumber String?
  nim         String?  // Untuk mahasiswa
  avatar      String?  // Untuk profile photo preset
  orders      Order[]
  tenantId    Int?     @unique
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

model Tenant {
  id       Int     @id @default(autoincrement())
  name     String
  location String
  isOpen   Boolean @default(true)
  image    String? // Untuk foto tenant
  menus    Menu[]
  orders   Order[]
  user     User?
}

model Menu {
  id            Int     @id @default(autoincrement())
  name          String
  price         Float
  estimatedTime Int     // Durasi masak dalam menit (FR Estimasi Waktu)
  isAvailable   Boolean @default(true)
  image         String? // Untuk foto menu hidangan
  tenantId      Int
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  tenantId   Int
  totalPrice Float
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  items      Json        // Menyimpan array detail menu [{menuId, name, qty}]
  feedback   Feedback?
}

model Feedback {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int      // 1-5 bintang
  comment   String?
  createdAt DateTime @default(now())
}